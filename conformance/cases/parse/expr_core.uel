analysis Budget {
  knowns {
    p_in <- req.R-1.p_in
    rate <- req.R-1.rate
  }
  params {
    n = 2
  }
  core expr {
    let lam = const.c0 / rate
    total_dbw = p_in + db(n) - (0.3 dB)
    density_dbhz = total_dbw - db(const.k_B) - db(290 K)
  }
  outputs {
    total_dbw : dBW ±
    density_dbhz : dBHz ± target >= 40 dBHz
  }
}

analysis Nominal {
  core stub {
    t_sys = 120 K ± 10 %
    bias = -1.5 dB
  }
  outputs {
    t_sys : K
    bias : dB
  }
}

requirement R-1 {
  p_in = 10 dBW ± 1 dB
  rate = 2 kHz
}
