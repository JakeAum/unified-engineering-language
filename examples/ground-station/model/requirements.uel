# X-band ground station for IMAP I-ALiRT direct broadcast — requirements.
# IMAP (Interstellar Mapping and Acceleration Probe) orbits Sun-Earth L1 and
# continuously broadcasts real-time space-weather data (I-ALiRT). This station
# receives that broadcast autonomously. Values marked estimate/± cal are design
# anchors pending the mission ICD; they are load-bearing references, so an ICD
# update ripples through every consuming analysis mechanically (spec §4.2).
requirement MIS-001 {
  text "The station shall receive the IMAP I-ALiRT X-band direct broadcast and deliver decoded frames to the network continuously during view periods."
  carrier_freq = 8447.5 MHz ± cal from "I-ALiRT RF ICD draft — near-Earth X-band downlink allocation"
  data_rate = 2000 Hz from "I-ALiRT ICD draft; information bit rate (1/s)"
}

requirement LNK-002 {
  text "The receive chain shall close the I-ALiRT link with margin >= 3 dB at maximum L1 range, worst-case declared conditions."
  eirp_dbw = 22 dBW ± cal from "I-ALiRT ICD draft: broadcast EIRP toward Earth, edge of coverage"
  max_range = 1650000 km from "L1 halo apogee + margin"
  required_ebn0_db = 4 dB from "CCSDS turbo r=1/2 BPSK at FER 1e-5"
  impl_loss_db = 1.5 dB from "demod implementation loss allocation"
  min_margin_db = 3 dB
  atm_loss_db = 0.2 dB from "clear air, 10 deg elevation, X-band"
  rain_alloc_db = 0.5 dB from "rain allocation for 99.5% availability, temperate site"
  pol_loss_db = 0.2 dB from "axial ratio allocation, RHCP"
}

requirement PNT-003 {
  text "Total RSS pointing error shall not exceed 0.05 deg in operational wind, and the resulting pointing loss shall not exceed 0.3 dB."
  max_pointing_error = 0.05 deg
  max_pointing_loss_db = 0.3 dB
  track_rate_max = 0.004 deg/s from "L1 sidereal-class apparent motion + halo"
}

requirement ENV-004 {
  text "The station shall operate to specification in operational wind and survive stowed in survival wind, across the site temperature range."
  wind_operational = 20 m/s
  wind_survival = 45 m/s
  min_elevation = 10 deg
  t_amb_min = -30 degC
  t_amb_max = 45 degC
}

requirement PWR-005 {
  text "The station shall run from a single utility feed with UPS ride-through for the receive chain."
  max_feed_power = 8 kW
  min_ride_through = 10 min
}

requirement CST-006 {
  text "The station shall be buildable for the program cost cap with commercial parts and one custom reflector/pedestal procurement."
}
