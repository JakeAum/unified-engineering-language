#!/bin/sh
# SessionStart hook: a waking agent is handed the work queue, not a blank repo.
#
# GENERATED by `{{TOOL}} harness install --target claude-code` from {{TOOL}} {{VERSION}}.
# Do not hand-edit — regenerate; `{{TOOL}} harness check` fails if this drifts.
#
# stdout lands in the session's context, so the first thing the agent knows is
# where the highest-value stale work is. All this file knows about the harness:
# stdout is context and CLAUDE_PROJECT_DIR names the repository root.
#
# Never fatal, never noisy: a repo whose tooling is missing must still open.
set -u

REPO="${CLAUDE_PROJECT_DIR:-$(pwd)}"
MANIFEST="{{MANIFEST}}"
# The brief, best rung first. Rungs are PROBED against the kernel actually
# installed here, so a subcommand this adapter was generated before — or after —
# is used when present and silently skipped when not. Detect, never assume.
LADDER='{{BRIEF_LADDER}}'
OPTIONAL='{{OPTIONAL_COMMANDS}}'

cd "$REPO" 2>/dev/null || exit 0
PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# Installed entry point, else the module — including a checkout that was never
# pip-installed. If neither answers, stay out of the way entirely.
if command -v {{TOOL}} >/dev/null 2>&1 && {{TOOL}} --version >/dev/null 2>&1; then
  UEL="{{TOOL}}"
elif python3 -m {{TOOL}} --version >/dev/null 2>&1; then
  UEL="python3 -m {{TOOL}}"
else
  exit 0
fi

supported() { # supported <subcommand> [<required-option>]
  $UEL "$1" --help >/dev/null 2>&1 || return 1
  [ "$#" -lt 2 ] || $UEL "$1" --help 2>&1 | grep -q -- "$2"
}

RUNG=''
OLDIFS=$IFS
IFS='|'
# shellcheck disable=SC2086
set -- $LADDER
IFS=$OLDIFS
for rung in "$@"; do
  [ -n "$rung" ] || continue
  # shellcheck disable=SC2086
  if supported $rung; then RUNG=$rung; break; fi
done
[ -n "$RUNG" ] || exit 0

PROJECTS=$(find "$REPO" -maxdepth 4 -name "$MANIFEST" -not -path '*/.*' 2>/dev/null |
  awk -F/ '{print NF"\t"$0}' | sort -n | cut -f2- | head -n {{MAX_PROJECTS}})
[ -n "$PROJECTS" ] || exit 0

echo "== {{TOOL}} {{VERSION}} — the standing work queue, highest value first =="
printf '%s\n' "$PROJECTS" | while IFS= read -r manifest; do
  [ -n "$manifest" ] || continue
  dir=$(dirname "$manifest")
  rel=${dir#"$REPO"/}
  [ "$rel" != "$dir" ] || rel='.'
  echo ""
  echo "-- $rel   \$ $UEL $RUNG $rel"
  # shellcheck disable=SC2086
  $UEL $RUNG "$dir" 2>&1 | sed 's/^/   /' | head -n {{MAX_LINES}}
done

for c in $OPTIONAL; do
  if supported "$c"; then echo ""; echo "also available in this kernel: \$ $UEL $c"; fi
done

echo ""
echo "{{LOOP_ONELINE}}"
echo "orient: \$ $UEL {{ORIENT}}   ·   operating skill: {{SKILL_REL}}"
exit 0
