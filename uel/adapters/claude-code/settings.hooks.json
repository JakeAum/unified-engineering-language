{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/uel-agenda.sh", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/uel-check.py", "timeout": 120}]}
    ]
  }
}
