# The structural-assumption taxonomy (spec §2.5, §10.1): claims about *dropped
# physics*, with hand-authored entailment rules. Draft 0.1 treats this as a declared
# taxonomy; the compatibility calculus is the language's foremost open research
# problem, and declared-but-unchecked beats undeclared.

claim rigid {
  doc "Body deforms negligibly; elasticity dropped."
  entails no_elastic_modes, no_structural_damping
  excludes elastic_modes
}

claim rigid_root {
  doc "Boundary idealization: the root fixture is treated as rigid."
}

claim elastic_modes {
  doc "Structural flexibility retained; modes exist and are computable."
  excludes rigid
}

claim static {
  doc "Time derivatives dropped; loads applied quasi-statically."
  entails no_transient_response
  excludes transient_response
}

claim steady_state {
  doc "Transients decayed; d/dt = 0 at the boundary."
  entails no_transient_response
}

claim transient_response {
  doc "Time-domain behavior retained."
  excludes no_transient_response
}

claim joint_heating {
  doc "Frictional heat generation at interfaces retained."
  excludes no_joint_heating
}

claim internal_gradient_field {
  doc "Spatial gradients within the element resolved (field model)."
  excludes no_internal_gradients
}

claim frictionless {
  doc "Coulomb/viscous interface friction dropped."
  entails no_joint_heating, no_stick_slip
}

claim adiabatic {
  doc "No heat exchange across the drawn boundary."
  entails no_boundary_heat_flux
  excludes boundary_heat_exchange
}

claim isothermal {
  doc "Temperature held constant across the element."
  excludes adiabatic
}

claim incompressible {
  doc "Density constant; roughly valid below Mach 0.3."
  excludes compressibility_effects
}

claim inviscid {
  doc "Viscous stresses dropped; no boundary layer, no skin friction."
  entails no_viscous_drag
}

claim lumped_element {
  doc "Spatial gradients unresolved within the element."
  entails no_internal_gradients
}

claim small_angle {
  doc "sin(x) ~ x; valid for deflections well under ~10 degrees."
}

claim linear_elastic {
  doc "Stress proportional to strain; no yielding modeled."
  excludes plasticity
}

claim point_mass {
  doc "Rotational inertia dropped."
  entails no_rotational_dynamics
}

claim topology_asserted {
  doc "Geometry core asserted its topological assumptions (spec §6.2)."
}

# Leaf claims referenced by entailments (declared so the web is closed).
claim no_elastic_modes { doc "No structural modes are available downstream." }
claim no_structural_damping { doc "No structural damping information exists." }
claim no_transient_response { doc "No time-domain response information exists." }
claim no_joint_heating { doc "Interfaces generate no frictional heat." }
claim no_stick_slip { doc "No stick-slip limit cycles possible." }
claim no_boundary_heat_flux { doc "Zero heat flux across the boundary." }
claim boundary_heat_exchange { doc "Heat crosses the boundary." }
claim compressibility_effects { doc "Density varies with pressure/velocity." }
claim no_viscous_drag { doc "No viscous drag contribution." }
claim no_internal_gradients { doc "No spatial gradient information inside the element." }
claim no_rotational_dynamics { doc "No rotational inertia information." }
claim plasticity { doc "Post-yield behavior modeled." }

# Hazard phenomena (v0.6): the failure modes registered models declare
# themselves blind to (stdlib/models.uel). They live in the taxonomy so that
# `hazard`/`covers`/`waive` names are spell-checked (UEL0504) and so covering
# analyses can `assume`/`require` against them like any structural claim.
claim lateral_torsional_buckling { doc "Compression flange rolls sideways; Mcr ~ flange t^3, ~ 1/L_unbraced^2." }
claim shear_deformation { doc "Shear flexibility matters; Euler-Bernoulli stiffness is flattered." }
claim local_buckling { doc "Plate or flange buckles locally below member-level capacity." }
claim brittle_fracture { doc "Failure by fracture without yield; ductile criteria do not apply." }
claim stress_concentration { doc "Local stress riser at a geometric feature; coarse meshes average it away." }
claim buckling_instability { doc "Stability failure in compression at stresses below yield." }
claim geometric_nonlinearity { doc "Equilibrium must be held on the deformed shape." }
claim root_compliance { doc "The clamped boundary is actually a spring; modes shift down." }
claim mode_truncation { doc "Physics living in modes outside the retained basis." }
claim vortex_shedding { doc "Periodic shedding at the Strouhal frequency; lock-in excites structure." }
claim drag_regime_shift { doc "Cd changes regime with Reynolds number (drag crisis)." }
claim coupled_modes { doc "Multi-DOF coupling places modes a lumped model cannot see." }
claim foundation_compliance { doc "Foundation/soil stiffness in series lowers structural modes." }
claim control_structure_spillover { doc "Control energy excites unmodeled structural modes." }
claim dynamic_torque_amplification { doc "Resonant amplification of drive loads through compliance." }
claim impedance_mismatch_ripple { doc "VSWR interaction between RF stages; gain/noise ripple across band." }
claim correlated_surface_error { doc "Correlated aperture deformation (gravity, thermal); Ruze underestimates." }
claim mutual_coupling { doc "Array elements interact; isolated-element patterns are wrong." }
claim interference { doc "In-band energy from other transmitters, absent from noise budgets." }
claim pointing_loss_dynamics { doc "Time-varying pointing error beyond the static loss allowance." }
claim correlated_error_terms { doc "Error terms sharing physics; RSS combination flatters the total." }
claim track_loss_of_lock { doc "Tracking loop loses its reference signal and diverges." }
claim transient_inrush { doc "Start/inrush transients far above steady draw." }
claim part_load_efficiency { doc "Efficiency is a curve in load, not a constant." }
claim peukert_effect { doc "Usable battery capacity falls with discharge rate." }
claim temperature_derate { doc "Capability falls with temperature away from the rating point." }
claim web_crippling { doc "Concentrated load buckles the web locally at a bearing point." }
